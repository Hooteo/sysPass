# Copy to .env (git-ignored) and fill in before running docker-compose up.

# Signing/HMAC secret used for URL signing, CSRF tokens and session security.
# Generated randomly on first boot if left empty here - but setting it lets
# you reproduce the same value across re-deployments/restores instead of a
# fresh random one being baked into a brand new app/config volume.
# Generate one with: openssl rand -hex 32
SYSPASS_PASSWORD_SALT=
