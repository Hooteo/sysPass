# Copy to .env (git-ignored) and fill in before running docker-compose up.
#
# Almost all of these are only ever read by sysPass the FIRST time it
# finds an empty app/config volume (no config.xml yet) - once config.xml
# exists, changing these env vars does nothing until you delete/replace
# it. This is intentional: it stops a stray env var change from silently
# altering a running instance's configuration. The one exception is
# SYSPASS_AUTO_MIGRATE, called out below, which is read on every start.
#
# See README.md, "Environment variables: fresh install vs. migration"
# for the full picture - the short version is inline below.

# ============================================================
# Always needed
# ============================================================

# Password for MariaDB's own "root" superuser (a fresh account created
# the first time the syspass-db volume is empty - nothing to do with any
# sysPass user). Needed to import a dump during a migration, or just to
# have DB admin access at all.
SYSPASS_DB_ROOT_PASS=

# ============================================================
# Recommended to set explicitly, even for a fresh install
# ============================================================

# Signing/HMAC secret used for URL signing (incl. public links), CSRF
# tokens and session security.
#   Fresh install: can be left empty (a random one is generated), but
#   setting it yourself means you actually have a copy of it saved
#   somewhere - you'll need this EXACT value if you ever migrate this
#   instance to a new host later (see MIGRATION.md), and there is no way
#   to recover it after the fact if you didn't write it down.
#     openssl rand -hex 32
#   Migration: this MUST be the OLD instance's <passwordSalt>, copied
#   verbatim from its config.xml - get this wrong and every public/deep
#   link generated before the migration breaks silently.
SYSPASS_PASSWORD_SALT=

# The DB user/database this app connects with. Pick any values you like
# - they do NOT need to match anything from an old server you might be
# migrating from (see MIGRATION.md: a schema-only dump never carries
# MySQL users, so there's nothing to "match" in the first place). The
# `syspass-db` service below creates this user and grants it access to
# this exact database name on first boot, before the schema even exists
# yet (docker/db-grant-init.sh) - works whether that schema then comes
# from the install wizard or from an imported dump.
#   Fresh install: NAME is whatever you also type into the install
#   wizard's "database name" field - just be consistent between the two.
#   USER/PASS themselves end up unused either way: sysPass's own install
#   wizard always creates its own separate random sp_<hex> app user
#   regardless of what's set here (stock sysPass installer behavior, not
#   something this fork controls) - only the grant this section sets up
#   matters for a fresh install, not the literal user/pass values.
#   Migration: these ARE what actually gets used, written straight into
#   the new config.xml (skips the install wizard entirely, see
#   SYSPASS_DB_VERSION below) - so pick real values, but again, they
#   don't need to match the old server's.
SYSPASS_DB_NAME=syspass
SYSPASS_DB_USER=syspass
SYSPASS_DB_PASS=

# ============================================================
# MIGRATION ONLY - leave both empty for a fresh install
# (the install wizard runs normally when they're empty)
# ============================================================

# Must be copied from the OLD instance's config.xml (<databaseVersion>
# and <appVersion>), not guessed - there's no way to read them back from
# the database itself. Get them wrong and sysPass either shows the
# install wizard again against your already-populated database, or tries
# to replay schema upgrades it's already applied. Once set, the
# entrypoint's auto-migrate (see README.md) brings the schema the rest
# of the way up to this fork's latest version by itself.
SYSPASS_DB_VERSION=
SYSPASS_APP_VERSION=

# ============================================================
# Rarely needed - sensible defaults already apply
# ============================================================

# Only change these if you're pointing at a database outside this
# compose file entirely. HOST defaults to "syspass-db" (the database
# service's name below, also its container_name, deliberately kept
# identical so there's only one name to remember either way).
SYSPASS_DB_HOST=syspass-db
SYSPASS_DB_PORT=3306

# Read on EVERY container start, not just the first. When "yes" (the
# default), the entrypoint automatically applies any pending DB schema
# upgrade on boot - equivalent to clicking through the browser's upgrade
# confirmation screen yourself, just done for you. This is what brings a
# migrated, older-schema database up to this fork's OTP/MFA schema
# automatically. Set to "no" to go back to confirming upgrades by hand.
SYSPASS_AUTO_MIGRATE=yes

# Pins every internal link and AJAX route in the app to this exact
# address, instead of letting it adapt to whatever host/IP the browser
# actually used to reach the site. LEAVE THIS EMPTY unless you have a
# specific reason to pin one (eg. a single public FQDN in front of a
# reverse proxy that's fronting a different internal address) - set it
# to an address that only works from *some* of the places you access
# sysPass from (eg. an FQDN that doesn't resolve when you're on the
# internal network, using an internal IP instead) and the app will look
# like it loads but nothing in it will actually work from there. See
# README.md if that's already happened to a running instance.
SYSPASS_APPLICATION_URL=
