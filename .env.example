# Copy to .env (git-ignored) and fill in before running docker-compose up.
#
# Almost all of these are only ever read by sysPass the FIRST time it
# finds an empty app/config volume (no config.xml yet) - once config.xml
# exists, changing these env vars does nothing until you delete/replace
# it. This is intentional: it stops a stray env var change from silently
# altering a running instance's configuration. The one exception is
# SYSPASS_AUTO_MIGRATE, called out below, which is read on every start.
#
# See README.md, "Environment variables: fresh install vs. migration"
# for the full picture of which of these to fill in for each case - the
# short version is inline below.

# ============================================================
# Needed for BOTH a fresh install and a migration
# ============================================================

# Signing/HMAC secret used for URL signing (incl. public links), CSRF
# tokens and session security.
#   Fresh install: leave empty, or generate one yourself:
#     openssl rand -hex 32
#   Migration: this MUST be the OLD instance's <passwordSalt>, copied
#   verbatim from its config.xml - get this wrong and every public/deep
#   link generated before the migration breaks silently.
SYSPASS_PASSWORD_SALT=

# Database connection + credentials. NAME/USER/PASS also drive the `db`
# service below (MYSQL_DATABASE/MYSQL_USER/MYSQL_PASSWORD), so the app
# and the database always agree - no hand-editing config.xml's dbUser/
# dbPass/dbName needed.
#
# HOST defaults to "db" (the compose service name) - only change it if
# you're pointing at a database outside this compose file, or at a fixed
# IP (see the static-IP network example at the bottom of docker-compose.yml,
# useful if your DB's GRANTs are scoped to a specific IP instead of '%').
#
#   Fresh install: NAME/USER/PASS can be anything you like.
#   Migration: NAME/USER/PASS must match the OLD instance's config.xml
#   EXACTLY, not values of your choosing.
#   GOTCHA: a migrated dbUser was very likely NOT "syspass" but something
#   like sp_<random hex> (auto-generated by the original install wizard) -
#   use that exact name, or the account created here won't match what's
#   actually stored in the imported data.
#   GOTCHA: MYSQL_ROOT_PASSWORD/MYSQL_DATABASE/MYSQL_USER/MYSQL_PASSWORD
#   are only applied by the mariadb image the FIRST time its data volume
#   is empty - if you're restoring an old syspass-db volume/dump, these
#   values must already match what's in that dump, they won't
#   retroactively create/rename/re-password anything on an existing volume.
SYSPASS_DB_HOST=db
SYSPASS_DB_PORT=3306
SYSPASS_DB_ROOT_PASS=
SYSPASS_DB_NAME=syspass
SYSPASS_DB_USER=syspass
SYSPASS_DB_PASS=

# ============================================================
# MIGRATION ONLY - leave both empty for a fresh install
# (the install wizard runs normally when they're empty)
# ============================================================

# Must be copied from the OLD instance's config.xml (<databaseVersion>
# and <appVersion>), not guessed - there's no way to read them back from
# the database itself. Get them wrong and sysPass either shows the
# install wizard again against your already-populated database, or tries
# to replay schema upgrades it's already applied.
SYSPASS_DB_VERSION=
SYSPASS_APP_VERSION=

# ============================================================
# Optional, either case
# ============================================================

# Read on EVERY container start, not just the first. When "yes" (the
# default), the entrypoint automatically applies any pending DB schema
# upgrade on boot - equivalent to clicking through the browser's upgrade
# confirmation screen yourself, just done for you. This is what brings a
# migrated, older-schema database up to this fork's OTP/MFA schema
# automatically. Set to "no" to go back to confirming upgrades by hand.
SYSPASS_AUTO_MIGRATE=yes

# Pins every internal link and AJAX route in the app to this exact
# address, instead of letting it adapt to whatever host/IP the browser
# actually used to reach the site. LEAVE THIS EMPTY unless you have a
# specific reason to pin one (eg. a single public FQDN in front of a
# reverse proxy that's fronting a different internal address) - set it
# to an address that only works from *some* of the places you access
# sysPass from (eg. an FQDN that doesn't resolve when you're on the
# internal network, using an internal IP instead) and the app will look
# like it loads but nothing in it will actually work from there. See
# README.md if that's already happened to a running instance.
SYSPASS_APPLICATION_URL=
