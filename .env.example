# Copy to .env (git-ignored) and fill in before running docker-compose up.
# All of these are only ever read by sysPass the FIRST time it finds an
# empty app/config volume (no config.xml yet) - once config.xml exists,
# changing these env vars does nothing until you delete/replace it. This
# is intentional: it stops a stray env var change from silently altering
# a running instance's configuration.

# Signing/HMAC secret used for URL signing (incl. public links), CSRF
# tokens and session security. Generated randomly on first boot if left
# empty - but a migrated database needs the SAME value the old instance
# used, or every public/deep link generated before the migration breaks.
# Generate a fresh one (for a brand new install) with: openssl rand -hex 32
SYSPASS_PASSWORD_SALT=

# Database connection + credentials. NAME/USER/PASS also drive the `db`
# service below (MYSQL_DATABASE/MYSQL_USER/MYSQL_PASSWORD), so the app and
# the database always agree - no more hand-editing config.xml's dbUser/
# dbPass/dbName by hand.
#
# HOST defaults to "db" (the compose service name) - only change it if
# you're pointing at a database outside this compose file, or at a fixed
# IP (see the static-IP network example at the bottom of docker-compose.yml,
# useful if your DB's GRANTs are scoped to a specific IP instead of '%').
# NAME is the actual schema name - don't confuse it with HOST, it's easy
# to do when they happen to both be "db".
#
# GOTCHA: MYSQL_ROOT_PASSWORD/MYSQL_DATABASE/MYSQL_USER/MYSQL_PASSWORD are
# only applied by the mariadb image the FIRST time its data volume is
# empty. If you're restoring an old syspass-db volume/dump, these values
# must match what that dump already has - MariaDB will NOT retroactively
# create/rename the user or change its password on an existing volume.
#
# GOTCHA: if you're migrating an old install, its dbUser was very likely
# NOT "syspass" but something like sp_<random hex> (auto-generated by the
# original install wizard) - use that exact name here, taken from the old
# config.xml, not a name of your choosing, or the account these create
# won't match what's actually stored in the imported data.
SYSPASS_DB_HOST=db
SYSPASS_DB_PORT=3306
SYSPASS_DB_ROOT_PASS=
SYSPASS_DB_NAME=syspass
SYSPASS_DB_USER=syspass
SYSPASS_DB_PASS=

# Only needed when importing an EXISTING (already installed) database,
# eg. migrating from another sysPass instance - leave both empty for a
# brand new install (the install wizard will run normally).
#
# GOTCHA: these must be copied from the OLD instance's config.xml
# (<databaseVersion> and <appVersion>), not guessed. There is no way to
# read them back from the database itself. Get them wrong and sysPass
# will either show the install wizard again against your restored
# (non-empty) database, or try to replay every schema upgrade from
# scratch against a database that already has them applied.
SYSPASS_DB_VERSION=
SYSPASS_APP_VERSION=

# Unlike the vars above, this one IS read on every container start, not
# just the first. When "yes" (the default), the entrypoint automatically
# applies any pending DB schema upgrade on boot - equivalent to visiting
# the app and clicking through the upgrade confirmation screen yourself,
# just done for you so "docker compose pull && docker compose up -d" is
# enough after a new image. Set to "no" to go back to confirming upgrades
# by hand in the browser.
SYSPASS_AUTO_MIGRATE=yes
